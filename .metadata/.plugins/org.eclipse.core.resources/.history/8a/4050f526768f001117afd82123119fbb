# ------------------------------------------------------------------
# DEV profile (default) - local MySQL, verbose SQL logging, debug-
# level app logging. Every value can still be overridden with an env
# var, but falls back to the same local defaults the project already
# used before profiles existed - so `mvn spring-boot:run` with no
# extra flags behaves exactly as before.
# ------------------------------------------------------------------

spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/emart}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:deokar2003}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

logging.level.root=INFO
logging.level.com.emart=DEBUG
logging.level.org.hibernate.SQL=DEBUG
